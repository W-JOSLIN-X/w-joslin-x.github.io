---
import { posts } from "../../utils/roxy";
import T from "./Text.astro";
const all = await posts();
const categories = [
	...new Set(all.map((p) => p.data.category).filter(Boolean)),
];
const tags = [...new Set(all.flatMap((p) => p.data.tags))];
const moods = [...new Set(all.flatMap((p) => p.data.moods))];
---
<section class="panel filters"><div class="filter-head"><h3><T k="filter"/></h3><a href="/browse/" data-reset-filter aria-label="Reset">↻</a></div>
<fieldset class="filter-group"><legend><T k="categories"/></legend><div class="type-options"><a class="filter-option" data-category="" href="/browse/"><T k="all"/><small>{all.length}</small></a>{categories.map(c=><a class="filter-option" data-category={c} href={`/browse/?type=${encodeURIComponent(c || '')}`}><span>{c}</span><small>{all.filter(p=>p.data.category===c).length}</small></a>)}</div></fieldset>
<fieldset class="filter-group"><legend><T k="tags"/></legend><div class="chips">{tags.map(t=><a class="chip" data-filter-tag={t} href={`/browse/?tag=${encodeURIComponent(t)}`}>{t}</a>)}</div></fieldset>
<fieldset class="filter-group"><legend><T k="moods"/></legend><div class="chips">{moods.map(m=><a class="chip" data-filter-mood={m} href={`/browse/?mood=${encodeURIComponent(m)}`}>{m}</a>)}</div></fieldset></section>
