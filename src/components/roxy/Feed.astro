---
import {
	posts,
	day,
	postHref,
	plainText,
	wordCount,
	slugOf,
} from "../../utils/roxy";
import Icon from "./Icon.astro";
import T from "./Text.astro";
const { browse = false } = Astro.props;
const all = await posts();
const categories = [
	...new Set(all.map((p) => p.data.category).filter(Boolean)),
];
const searchData = all.map((p) => ({
	id: p.id,
	slug: slugOf(p.id),
	title: p.data.title,
	href: postHref(p.id),
	published: day(p.data.published),
	updated: p.data.updated ? day(p.data.updated) : "",
	text: plainText(p.body || ""),
	tags: p.data.tags,
	moods: p.data.moods,
	category: p.data.category,
}));
---
<div id="feed-root" data-browse={String(browse)}>
<div class="category-bar panel"><a href="/" aria-label="Home"><Icon name="home" size={18}/></a><a href="/browse/" data-category=""><T k="all"/><small>{all.length}</small></a>{categories.map(c=><a href={`/browse/?type=${encodeURIComponent(c || '')}`} data-category={c}>{c}<small>{all.filter(p=>p.data.category===c).length}</small></a>)}</div>
<div id="active-filters" class="active-filters" hidden></div>
<div class="result-heading" hidden={!browse}><T k="posts"/><span id="result-count">{all.length}</span><a href="/browse/" data-reset-filter><T k="reset"/> ↻</a></div>
<div id="post-feed" hidden={browse}>{all.map((p,i)=><div class="feed-entry" data-post-id={p.id} data-month={day(p.data.published).slice(0,7)} hidden={i>=12}><h2 class="month-heading" hidden={i>0&&day(all[i-1].data.published).slice(0,7)===day(p.data.published).slice(0,7)}>{day(p.data.published).slice(0,7).replace('-',' / ')}</h2><article class:list={['post-card',{'has-cover':!!p.data.image}]}><div class="card-content"><h3><a href={postHref(p.id)}>{p.data.title}</a></h3><div class="card-meta"><span><i><Icon name="calendar" size={16}/></i><time datetime={day(p.data.published)}>{day(p.data.published)}</time></span><a href={`/browse/?type=${encodeURIComponent(p.data.category || '')}`}><i><Icon name="book" size={16}/></i>{p.data.category}</a><span><i><Icon name="file" size={16}/></i>{wordCount(p.body||'')} <T k="wordUnit"/></span><span><Icon name="clock" size={14}/>{Math.max(1,Math.ceil(wordCount(p.body||'')/350))} <T k="minutes"/></span></div><p class="card-summary">{p.data.description||plainText(p.body||'').slice(0,100)}</p><div class="card-tags">{p.data.tags.map(t=><a href={`/browse/?tag=${encodeURIComponent(t)}`} class="chip"># {t}</a>)}{p.data.moods.map(m=><a href={`/browse/?mood=${encodeURIComponent(m)}`} class="chip mood-chip">{m}</a>)}</div>{p.data.updated&&<p class="card-updated"><T k="updated"/> {day(p.data.updated)}</p>}</div>{p.data.image?<a href={postHref(p.id)} class="card-cover-link" aria-label={p.data.title}><img class="card-cover" src={p.data.image} alt="" loading="lazy"/></a>:<a class="card-arrow" href={postHref(p.id)} aria-label={p.data.title}><Icon name="chevron" size={24}/></a>}</article></div>)}</div>
<section class="panel timeline" id="timeline" hidden={!browse}>{all.map(p=><div class="timeline-entry" data-post-id={p.id} data-year={day(p.data.published).slice(0,4)}><h2 class="timeline-year">{day(p.data.published).slice(0,4)}<span></span><small></small></h2><div class="timeline-row"><time>{day(p.data.published).slice(5)}</time><span class="timeline-dot"></span><a class="timeline-title" href={postHref(p.id)}>{p.data.title}</a><div class="timeline-tags">{p.data.tags.map(t=><a href={`/browse/?tag=${encodeURIComponent(t)}`} data-filter-tag={t}>#{t}</a>)}</div></div></div>)}</section>
<section class="panel empty-state" id="no-results" hidden><T k="empty"/></section><button class="load-more" id="load-more" hidden={all.length<=12}><T k="more"/> ↓</button><section class="panel commit-list" id="date-commits" hidden><h3><T k="commits"/></h3><div></div></section>
<script is:inline type="application/json" id="search-data" set:html={JSON.stringify(searchData).replace(/</g,'\\u003c')}/><script src="../../scripts/roxy-feed.ts"></script>
</div>
